  },
  "components": {
    "schemas": {
      "Body_uploadImage_api_v1_images_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File",
            "description": "JPEG, PNG or static WebP; up to MAX_UPLOAD_MB"
          },
          "public": {
            "type": "boolean",
            "title": "Public",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_uploadImage_api_v1_images_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ImageOutput": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "state": {
            "type": "string",
            "title": "State"
          },
          "public": {
            "type": "boolean",
            "title": "Public"
          },
          "size": {
            "type": "integer",
            "title": "Size"
          },
          "width": {
            "type": "integer",
            "title": "Width"
          },
          "height": {
            "type": "integer",
            "title": "Height"
          },
          "created": {
            "type": "number",
            "title": "Created"
          },
          "reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reason"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          },
          "views": {
            "type": "integer",
            "title": "Views"
          },
          "bytes_served": {
            "type": "integer",
            "title": "Bytes Served"
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "state",
          "public",
          "size",
          "width",
          "height",
          "created",
          "reason",
          "url",
          "views",
          "bytes_served"
        ],
        "title": "ImageOutput"
      },
      "ImagePage": {
        "properties": {
          "images": {
            "items": {
              "$ref": "#/components/schemas/ImageOutput"
            },
            "type": "array",
            "title": "Images"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "title": "Offset"
          }
        },
        "type": "object",
        "required": [
          "images",
          "total",
          "limit",
          "offset"
        ],
        "title": "ImagePage"
      },
      "KeyInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "scopes": {
            "items": {
              "type": "string",
              "enum": [
                "images:read",
                "images:write",
                "images:delete"
              ]
            },
            "type": "array",
            "maxItems": 3,
            "minItems": 1,
            "title": "Scopes"
          },
          "expiresInDays": {
            "type": "integer",
            "maximum": 365.0,
            "minimum": 1.0,
            "title": "Expiresindays",
            "default": 90
          }
        },
        "type": "object",
        "required": [
          "name",
          "scopes"
        ],
        "title": "KeyInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
