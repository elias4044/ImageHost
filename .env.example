BASE_URL=http://localhost:8000
# Single quotes preserve literal dollar signs in Argon2 hashes in Docker Compose .env files.
ADMIN_PASSWORD_HASH='paste-output-of-python-m-app.password-here'
# Native Python startup defaults to local. Docker Compose explicitly uses http.
# NSFW_BACKEND=local
# Optional malware scanning also needs the antivirus Compose profile or a running clamd.
ANTIVIRUS_ENABLED=false
# Shared secret for the bundled local scanner. Generate with secrets.token_urlsafe(48).
# Only needed for Docker or NSFW_BACKEND=http. Direct Python startup uses local inference.
NSFW_TOKEN=
# Optional specialist check. Leave both empty for NSFW-only screening.
SAFETY_URL=
SAFETY_TOKEN=
NSFW_THRESHOLD=0.5
MAX_UPLOAD_MB=20
MAX_STORAGE_MB=10240
